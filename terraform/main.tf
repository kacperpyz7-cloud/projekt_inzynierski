terraform {
  required_providers {
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.0"
    }
    helm = {
      source  = "hashicorp/helm"
      version = "~> 2.0"
    }
  }
}

# Terraform korzysta z lokalnego klastra Minikube.
provider "kubernetes" {
  config_path    = "~/.kube/config"
  config_context = "minikube"
}

provider "helm" {
  kubernetes {
    config_path    = "~/.kube/config"
    config_context = "minikube"
  }
}

# Wszystkie komponenty aplikacji działają w jednym namespace.
resource "kubernetes_namespace" "dataops" {
  metadata {
    name = "dataops"
  }
}

